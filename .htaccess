RewriteEngine On
RewriteBase /

# Редирект robots.txt на динамический генератор (файл в public/)
RewriteRule ^robots\.txt$ public/robots.php [L]

# 0. Редирект с портом :443 на URL без порта (301)
RewriteCond %{HTTP_HOST} ^(www\.)?pkvartira\.ru:443$ [NC]
RewriteRule ^(.*)$ https://%1pkvartira.ru/$1 [R=301,L]

# 0.1. Редирект www → без www (301)
RewriteCond %{HTTP_HOST} ^www\.pkvartira\.ru$ [NC]
RewriteRule ^(.*)$ https://pkvartira.ru/$1 [R=301,L]

# 0.2. Принудительный HTTPS для pkvartira.ru (главное зеркало https://pkvartira.ru)
# Совместимо с прокси (Cloudflare, nginx): проверяем и HTTPS и X-Forwarded-Proto
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} ^(www\.)?pkvartira\.ru$ [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# 1. Редирект с двойного слэша на одинарный (301)
RewriteCond %{REQUEST_URI} ^(.*)//(.*)$
RewriteRule . %1/%2 [R=301,L]

# 3. Редирект со слэша на без слэша для НЕ директорий (301)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L]

# Сжатие — только если модули доступны (безопасно для shared-хостинга)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml font/woff2
</IfModule>

# Кэш статики — только если mod_expires доступен
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresDefault "access plus 2 hours"
</IfModule>

# Безопасные заголовки кэша — только если mod_headers доступен, без always
<IfModule mod_headers.c>
  <FilesMatch "\.(webp|avif|jpg|jpeg|png|svg|css|js|woff2|woff)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Если файл или директория существуют, используем их напрямую
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Внутренне переписываем запрос на index.php
RewriteRule ^(.*)$ index.php?route=$1 [QSA,L]
