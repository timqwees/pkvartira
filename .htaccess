RewriteEngine On
RewriteBase /

# Редирект robots.txt на динамический генератор
RewriteRule ^robots\.txt$ robots.php [L]

# 0. Редирект с портом :443 на URL без порта (301)
RewriteCond %{HTTP_HOST} ^(www\.)?pkvartira\.ru:443$ [NC]
RewriteRule ^(.*)$ https://%1pkvartira.ru/$1 [R=301,L]

# 0.1. Редирект www → без www (301)
RewriteCond %{HTTP_HOST} ^www\.pkvartira\.ru$ [NC]
RewriteRule ^(.*)$ https://pkvartira.ru/$1 [R=301,L]

# 0.2. Принудительный HTTPS для pkvartira.ru (301) — главное зеркало https://pkvartira.ru
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} ^(www\.)?pkvartira\.ru$ [NC]
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# 1. Редирект с двойного слэша на одинарный (301)
RewriteCond %{REQUEST_URI} ^(.*)//(.*)$
RewriteRule . %1/%2 [R=301,L]

# 3. Редирект со слэша на без слэша для НЕ директорий (301)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L]

# Сжатие (gzip/brotli если доступно)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# Кэш статики 1 год + immutable
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresDefault "access plus 2 hours"
</IfModule>
<IfModule mod_headers.c>
  # Кэш статики
  <FilesMatch "\.(webp|jpg|jpeg|png|svg|avif|css|js|woff2|woff)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
    Header set Vary "Accept-Encoding"
  </FilesMatch>
  # HTML не кэшировать жёстко (для актуальности)
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # Безопасность
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  # HSTS только для https (требует проверки сертификата)
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" env=HTTPS
  # CSP базовая (мягкая, без блокировки)
  Header always set Content-Security-Policy "upgrade-insecure-requests"
</IfModule>

# Запрет листинга директорий
Options -Indexes

# Если файл или директория существуют, используем их напрямую
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Внутренне переписываем запрос на public/index.php с параметром route
RewriteRule ^(.*)$ index.php?route=$1 [QSA,L]
