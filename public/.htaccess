RewriteEngine On
RewriteBase /

# Редирект robots.txt на динамический генератор
RewriteRule ^robots\.txt$ robots.php [L]

# Редирект sitemap на динамический генератор (все через PHP-роутер)

# 0. Редирект с портом :443 на URL без порта (301)
RewriteCond %{HTTP_HOST} ^(www\.)?pkvartira\.ru:443$ [NC]
RewriteRule ^(.*)$ https://%1pkvartira.ru/$1 [R=301,L]

# 0.1. Редирект www → без www (301)
RewriteCond %{HTTP_HOST} ^www\.pkvartira\.ru$ [NC]
RewriteRule ^(.*)$ https://pkvartira.ru/$1 [R=301,L]

# 1. Редирект с двойного слэша на одинарный (301)
RewriteCond %{REQUEST_URI} ^(.*)//(.*)$
RewriteRule . %1/%2 [R=301,L]

# 3. Редирект со слэша на без слэша для НЕ директорий (301)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L]

# Сжатие статики (безопасно для shared-хостинга)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml font/woff2
</IfModule>

# ETag для условных запросов (304 Not Modified)
FileETag MTime Size

# Кэш: ТОЛЬКО статика через Expires (без директив Header — их ставит PHP).
# HTML управляется из PHP (SecurityHeaders), дубля Cache-Control нет.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
</IfModule>

# Если файл или директория существуют, используем их напрямую
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Внутренне переписываем запрос на public/index.php с параметром route
RewriteRule ^(.*)$ index.php?route=$1 [QSA,L]